{
  "name": "dsh-pure-mode",
  "version": "0.4.0",
  "description": "DSH 纯净模式：只装配你自己的提示词；左上角「纯净模式」面板管理全局 / 会话提示词。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snow-quiet/dsh-pure-mode.git"
  },
  "homepage": "https://github.com/snow-quiet/dsh-pure-mode#readme",
  "bugs": {
    "url": "https://github.com/snow-quiet/dsh-pure-mode/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./agent": "./agent.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "agent.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-0 <0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dshTarget": "0.2.1-rc.2",
  "license": "MIT"
}
